# EditorConfig — https://editorconfig.org

# Arquivo raiz
root = true

# Configurações para todos os arquivos
[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Markdown
[*.md]
trim_trailing_whitespace = false

# Python
[*.py]
indent_size = 4

# Makefiles
[Makefile]
indent_style = tab
